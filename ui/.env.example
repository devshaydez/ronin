# Addresses change after each redeploy. Copy values from DEPLOYMENTS.md. Never hard-code them.
# Base Sepolia vault. Setting this switches the UI from demo mode to live mode.
VITE_VAULT_ADDRESS=
# Unichain Sepolia vault and the pool whose freeze flag is shown on Safety.
VITE_UNICHAIN_VAULT_ADDRESS=
VITE_POOL_U_ADDRESS=
# Comma-separated pool addresses read by the Pools page. Base: Aave adapter + stress pool.
VITE_BASE_POOL_ADDRESSES=
# Unichain: all 16 mock pools from vault.pools(i), in order.
VITE_UNICHAIN_POOL_ADDRESSES=
VITE_LASNA_RPC=https://lasna-rpc.rnk.dev/
# Links used by the measured-proof block and footer.
VITE_GITHUB_URL=https://github.com/devshaydez/ronin
VITE_PROOF_URL=
